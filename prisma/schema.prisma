generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  created_at    Int
  password      String?
  role          String    @default("member")
  first_name    String?
  last_name     String?
  date_of_birth String?
  bio           String?

  sessions Session[]

  @@map("users")
}

model Session {
  id         String @id
  user_id    String
  expires_at Int

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}
